# TOSS TMS — copy to .env.local and fill in. Never commit real keys.

# Supabase (shared project with TOSS Leads: same logins)
NEXT_PUBLIC_SUPABASE_URL=https://grvuqxxjjiebnxnwcmxu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Mapbox: maps in the browser + highway miles on the server.
# Use a public token (pk.…) restricted to your app's URLs in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# DeepSeek: reads rate confirmations (server only). If it's down, a local reader fills the basics.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin panel (/admin): invite people and manage access to TOSS TMS and TOSS Leads.
# Server only, never NEXT_PUBLIC. Supabase → Project Settings → API Keys → secret key.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# Where TOSS Leads runs (invite links for Leads-only people, "Open TOSS Leads" in the menu).
NEXT_PUBLIC_LEADS_URL=https://www.tossleadhunter.tech
